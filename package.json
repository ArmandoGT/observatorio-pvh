{
  "name": "observatorio-obras-porto-velho",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "sync": "tsx scripts/sync.ts",
    "data:export": "tsx scripts/export-supabase.ts",
    "probe": "node scripts/probe.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "cheerio": "1.2.0",
    "lucide-react": "0.468.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "supabase": "2.120.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "wrangler": "4.149.0"
  }
}
