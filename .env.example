# Servidor Next.js/Worker e coleta. Nunca use NEXT_PUBLIC_ nestas chaves.
# No Worker PostgreSQL, use o binding HYPERDRIVE (usuario de leitura).
# Para coleta manual e Next.js local, configure a URL com o usuario adequado.
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:32770/observatorio_pvh
DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\nCA_PUBLICA\n-----END CERTIFICATE-----\n"

# Somente para retornar explicitamente ao provedor anterior.
SUPABASE_URL=https://sfdosulgapmxaprtbeve.supabase.co
SUPABASE_SECRET_KEY=sb_secret_SUBSTITUA_NO_AMBIENTE
SUPABASE_REQUIRED=true

# Necessários apenas para publicar manualmente ou pelo GitHub Actions.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Opcional: a API municipal atualmente aceita acesso anônimo.
PMPV_API_TOKEN=
